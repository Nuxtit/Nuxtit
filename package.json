{
  "name": "nuxtit",
  "version": "1.0.0",
  "description": "Nuxtit - Nuxt Reddit Client",
  "author": "Nuxtit",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start",
    "nuxt:generate": "nuxt generate",
    "generate": "nuxt generate && netlify-lambda build ./functions/",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "lintfix": "eslint --ext .js,.vue --ignore-path .gitignore . --fix",
    "netlify:build": "nuxt build && netlify-lambda build ./functions/",
    "lambda": "netlify-lambda serve .",
    "precommit": "npm run lint"
  },
  "dependencies": {
    "@feathersjs/feathers": "^4.5.12",
    "@feathersjs/rest-client": "^4.5.12",
    "@nuxtjs/axios": "^5.0.0",
    "@nuxtjs/proxy": "^1.3.1",
    "@nuxtjs/sentry": "^6.0.3",
    "argv": "^0.0.2",
    "axios-retry": "^3.1.2",
    "babel-eslint": "^10.0.2",
    "bootstrap": "^4.6.1",
    "bootstrap-vue": "^2.21.2",
    "cryptico": "^1.0.2",
    "date-fns": "2",
    "dotenv": "^10.0.0",
    "eslint": "5.16.0",
    "eslint-loader": "^2.0.0",
    "eslint-plugin-vue": "^5.2.3",
    "fontello-cli": "^0.6.2",
    "get-youtube-id": "^1.0.1",
    "idb-keyval": "^6.1.0",
    "lodash": "^4.17.21",
    "mark.js": "^8.11.1",
    "netlify-lambda": "^2.0.15",
    "node-sass": "6",
    "nodemon": "^2.0.3",
    "nuxt": "^2.12.0",
    "pug": "^3.0.1",
    "pug-plain-loader": "^1.0.0",
    "qs": "^6.10.3",
    "sass-loader": "10",
    "shell_exec": "^1.0.3",
    "tumblr.js": "3",
    "vue-backtotop": "^1.4.12",
    "vue-ctk-date-time-picker": "^2.4.0"
  }
}
